# Local environment secrets; sanitized examples may be tracked.
.env
.env.*
!.env.example

# Deploy-time env files are host-only (nonsecret values and image pins) and
# must never be committed; only their `.example` templates are tracked.
images.env
images.env.*
smtp.env
google.env

# Private-key filenames (not a substitute for checking the diff).
*.key
id_rsa
id_ed25519

# macOS metadata.
.DS_Store

# Git diff files.
git.diff

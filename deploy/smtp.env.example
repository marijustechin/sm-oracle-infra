# Section 7 staging SMTP settings — nonsecret, review-only template.
#
# Copy to `smtp.env` (outside Git; ignored) and fill in the staging provider
# values. `deploy.sh` sources it and `compose.yaml` interpolates the values as
# required (`${SMTP_HOST:?…}`), so a missing value fails `deploy.sh validate`.
#
# The SMTP PASSWORD is NOT here. It is a root-managed file secret:
#   /etc/sokoladas-staging/secrets/smtp_password  (owner app UID 10001, mode 0400)
# mounted read-only as `SMTP_PASSWORD_FILE`. Never commit the password or
# `smtp.env`.

# Provider SMTP hostname.
SMTP_HOST=
# Provider SMTP port (for example 465 or 587).
SMTP_PORT=
# Explicit "true" (implicit TLS, e.g. 465) or "false" (e.g. STARTTLS 587).
# Never inferred from the port by the application.
SMTP_SECURE=
# Provider SMTP username.
SMTP_USER=
# Sender address, bare or `Name <address>`; must be authorized by the provider.
MAIL_FROM=

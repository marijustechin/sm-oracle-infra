# Section 7 staging Google OAuth settings — nonsecret, review-only template.
#
# Copy to `google.env` (outside Git; ignored) and fill in the Google Cloud OAuth
# web client values. `deploy.sh` sources it and `compose.yaml` interpolates the
# values as required, so a missing value fails `deploy.sh validate`.
#
# The Google CLIENT SECRET is NOT here. It is a root-managed file secret:
#   /etc/sokoladas-staging/secrets/google_client_secret  (owner app UID 10001,
#   mode 0400), mounted read-only as `GOOGLE_CLIENT_SECRET_FILE`. Never commit it.

# Google OAuth web client ID (public, nonsecret).
GOOGLE_CLIENT_ID=
# Authorized redirect URI. Must equal the Google Cloud OAuth client's
# "Authorized redirect URI" exactly:
#   https://sokoladas.eu/api/auth/google/callback
GOOGLE_CALLBACK_URL=https://sokoladas.eu/api/auth/google/callback

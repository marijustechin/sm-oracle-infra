[Unit]
Description=Daily encrypted off-server backup for the SapiensMetric closed-review stack

[Timer]
# ~03:30 Europe/Vilnius, offset from the Sokoladas job. Persistent catches up a
# run missed while powered off.
OnCalendar=*-*-* 03:30:00 Europe/Vilnius
RandomizedDelaySec=300
Persistent=true
Unit=sapiensmetric-backup.service

[Install]
WantedBy=timers.target

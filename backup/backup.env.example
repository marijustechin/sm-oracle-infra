# Non-secret backup configuration for sokoladas-demo.
# Installed root-owned at /etc/sokoladas-staging/backup/backup.env (mode 0600).
# No secret values belong here; the rclone token and crypt password live in
# /etc/sokoladas-staging/backup/rclone.conf (mode 0600).

PROJECT=sokoladas-staging
DB_CONTAINER=sokoladas-staging-db-1
DB_NAME=sokoladas_staging
DB_SUPERUSER=postgres
DB_ADMIN_PASSWORD_FILE=/etc/sokoladas-staging/secrets/db_admin_password
MEDIA_VOLUME_PATH=/var/lib/docker/volumes/sokoladas-staging_media_data/_data
MEDIA_SUBDIR=products
SOKOLADAS_ROOT=/opt/sokoladas-staging
DEPLOY_LOCK=/opt/sokoladas-staging/state/deploy.lock
BACKUP_ROOT=/opt/sokoladas-staging/backup
STAGING_DIR=/opt/sokoladas-staging/backup/staging
LOG_FILE=/var/log/sokoladas-backup.log
RUN_LOCK=/run/sokoladas-backup.lock

RCLONE_BIN=rclone
RCLONE_CONFIG=/etc/sokoladas-staging/backup/rclone.conf
REMOTE=crypt:
SET_PREFIX=sokoladas-backups/sets

# Retention: latest 7 successful daily sets and 4 weekly sets.
KEEP_DAILY=7
KEEP_WEEKLY=4

MIN_FREE_MB=2048
LOCK_WAIT_SECONDS=900
UPLOAD_RETRIES=3
# download = re-download and checksum the uploaded set (strongest); size = fast.
VERIFY_MODE=download

# Optional failure notification via the existing Resend channel. Leave empty to
# disable. The recipient address is not a secret.
NOTIFY_TO=

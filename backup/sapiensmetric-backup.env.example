# SapiensMetric backup configuration (host-only; /etc/sapiensmetric/backup/backup.env).
# Values shown are the accepted defaults; adjust only with a reason. No secrets.
PROJECT=sapiensmetric-review
DB_CONTAINER=sapiensmetric-review-db-1
PROJECT_DIR=/opt/sapiensmetric-review
HOSTENV=/opt/sapiensmetric-review/hostenv
SECRETS_DIR=/etc/sapiensmetric/secrets
BACKUP_ROOT=/opt/sapiensmetric-review/backup
STAGING_DIR=/opt/sapiensmetric-review/backup/staging
LOG_FILE=/var/log/sapiensmetric-backup.log
RUN_LOCK=/run/sapiensmetric-backup.lock
# Reuse the existing Sokoladas rclone crypt remote, with a separate destination.
RCLONE_CONFIG=/etc/sokoladas-staging/backup/rclone.conf
REMOTE=crypt:
SET_PREFIX=sapiensmetric-backups/sets
KEEP_DAILY=7
KEEP_WEEKLY=4
MIN_FREE_MB=2048
UPLOAD_RETRIES=3
VERIFY_MODE=download
